# Copiar a .env.local y completar con Supabase → Project Settings → API

# App (Vercel) y scripts
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Servidor (Vercel), sincronizador y alertas (GitHub Actions). ¡Nunca con prefijo NEXT_PUBLIC_!
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# API de Datos Abiertos de la DGCP (sin autenticación)
DGCP_API_BASE=https://datosabiertos.dgcp.gob.do/api-dgcp/v1

# Resumen diario por correo (https://resend.com → API Keys)
RESEND_API_KEY=
ALERTAS_REMITENTE=Radar de Compras <alertas@tudominio.com>
URL_APP=https://comprasrd-zkbu.vercel.app

# Días que se conservan los procesos que no le interesan a ninguna empresa
DIAS_RETENCION=120
