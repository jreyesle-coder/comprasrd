# Copiar a .env.local y completar con los datos de Supabase → Project Settings → API

# App (Vercel) y sincronizador
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Solo sincronizador (GitHub Actions / local). ¡Nunca en Vercel ni en el navegador!
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# API de Datos Abiertos de la DGCP (sin autenticación)
DGCP_API_BASE=https://datosabiertos.dgcp.gob.do/api-dgcp/v1
